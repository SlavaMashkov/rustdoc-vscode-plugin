{
  "name": "rustdoc-viewer",
  "displayName": "Rust Doc Side Viewer",
  "description": "Preview Rust doc comments as formatted documentation in a side panel — like the built-in Markdown preview, but for Rust /// and //! doc comments",
  "version": "0.4.5",
  "publisher": "SlavaMashkov",
  "author": {
    "name": "SlavaMashkov",
    "url": "https://github.com/SlavaMashkov"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SlavaMashkov/rustdoc-vscode-plugin"
  },
  "bugs": {
    "url": "https://github.com/SlavaMashkov/rustdoc-vscode-plugin/issues"
  },
  "homepage": "https://github.com/SlavaMashkov/rustdoc-vscode-plugin#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "rust",
    "documentation",
    "preview",
    "rustdoc",
    "doc comments"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:rust"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rustdocViewer.openPreview",
        "title": "Rust Doc: Open Preview to the Side",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "editorLangId == rust",
          "command": "rustdocViewer.openPreview",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "npm run compile -- --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.3",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "highlight.js": "^11.11.1"
  }
}
